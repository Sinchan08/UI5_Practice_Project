<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:form="sap.ui.layout.form"
  controllerName="ui5.image.controller.App">

  <Button text="{i18n>pressMeText}"/>

  <Input id="my_name" value="{/employee/name}" />

  <Input value="{/employee/city}"/>


  <Image id="Image" src="Image/image.png" width="100px" height="100px" press="onImagePress" class="sapUiSmallMarginBegin"/>
  <Image id="Image1" src="Image/image1.png" width="100px" height="100px" press="onImagePress" class="sapUiSmallMarginBegin" />
   
   <form:SimpleForm >
     <form:content>

       <Toolbar>
         <content>

         </content>


       </Toolbar>

        
        <RadioButtonGroup id="rbg1" columns="2" width="100%" class="sapUiMediumMarginBottom">
			<buttons>
      <RadioButton id="RB1-1" text="Long Option Number 1" />
			<RadioButton id="RB1-2" text="Option 2" enabled="true" />
			<RadioButton id="RB1-3" text="Nr. 3" editable="false" />
			<RadioButton id="RB1-4" text="Long Option 4" />
			<RadioButton id="RB1-5" text="Option 5" />
			<RadioButton id="RB1-6" text="Nr. 6" />
      </buttons>
		</RadioButtonGroup>
     </form:content>
   </form:SimpleForm>
   

</mvc:View>